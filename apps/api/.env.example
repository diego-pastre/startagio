# Lista completa e valores de produção: docs/variaveis-de-ambiente.md

# Em produção use "production": é isso que marca o cookie de login como seguro (só HTTPS).
NODE_ENV=development
PORT=3333

# Banco do docker-compose.yml da raiz. Em dev usamos o root porque o `prisma migrate dev`
# precisa criar um banco temporário ("shadow database") para comparar as migrações.
# Em produção use o endereço do banco da hospedagem, sempre no formato mysql://.
DATABASE_URL=mysql://root:startagio@localhost:3306/stagio_db

# Gere um valor aleatório longo (mínimo 32 caracteres), por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use um valor diferente em produção. Trocar o segredo desloga todo mundo.
JWT_SECRET=
JWT_EXPIRES_IN_HORAS=24
